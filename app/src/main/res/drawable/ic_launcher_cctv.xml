<?xml version="1.0" encoding="utf-8"?>
<!-- Surveillance-camera mark v2: ceiling plate, angled mount arm, bold bullet
     body, lens ring (even-odd donut) with center dot. White on transparent;
     reused by ic_launcher_foreground (scaled) and ic_splash_icon. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Ceiling mount plate -->
    <path
        android:pathData="M14.6,6.9H19.4"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.2"
        android:strokeLineCap="round" />
    <!-- Mount arm, angled down-left onto the camera body -->
    <path
        android:pathData="M16.8,8.1L14.2,11.9"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.9"
        android:strokeLineCap="round" />
    <!-- Bullet camera body (pill) -->
    <path
        android:pathData="M10,14.9H16.4"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round" />
    <!-- Lens ring: outer disc minus inner disc via even-odd fill -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M2.3,14.9a2.4,2.4 0 1,0 4.8,0a2.4,2.4 0 1,0 -4.8,0z M3.3,14.9a1.4,1.4 0 1,0 2.8,0a1.4,1.4 0 1,0 -2.8,0z" />
    <!-- Lens center dot, visible through the ring's hole -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M4,14.9a0.7,0.7 0 1,0 1.4,0a0.7,0.7 0 1,0 -1.4,0z" />
</vector>
