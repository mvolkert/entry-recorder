<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon foreground: CCTV mark v2 scaled from the 24dp grid (x2.75)
     into the 66dp safe zone, centered on the 108dp canvas. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:name="mark"
        android:scaleX="2.75"
        android:scaleY="2.75"
        android:translateX="27.75"
        android:translateY="27.75">
        <!-- Ceiling mount plate -->
        <path
            android:pathData="M14.6,6.9H19.4"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="2.2"
            android:strokeLineCap="round" />
        <!-- Mount arm -->
        <path
            android:pathData="M16.8,8.1L14.2,11.9"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="1.9"
            android:strokeLineCap="round" />
        <!-- Bullet camera body (pill) -->
        <path
            android:pathData="M10,14.9H16.4"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="5"
            android:strokeLineCap="round" />
        <!-- Lens ring: outer disc minus inner disc via even-odd fill -->
        <path
            android:fillColor="#FFFFFFFF"
            android:fillType="evenOdd"
            android:pathData="M2.3,14.9a2.4,2.4 0 1,0 4.8,0a2.4,2.4 0 1,0 -4.8,0z M3.3,14.9a1.4,1.4 0 1,0 2.8,0a1.4,1.4 0 1,0 -2.8,0z" />
        <!-- Lens center dot -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M4,14.9a0.7,0.7 0 1,0 1.4,0a0.7,0.7 0 1,0 -1.4,0z" />
    </group>
</vector>
