<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon foreground: the CCTV mark scaled from the 24dp grid (x2.75)
     so the artwork occupies the 66dp safe zone, centered on the 108dp canvas. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:name="mark"
        android:scaleX="2.75"
        android:scaleY="2.75"
        android:translateX="27.75"
        android:translateY="27.75">
        <!-- Ceiling mount plate -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M6.6,2.6h5.8a1,1 0 0 1 0,2H6.6a1,1 0 0 1 0,-2z" />
        <!-- Mount arm -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M9,4.6h2v3.4H9z" />
        <!-- Pivot ball -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M10,6.7m-1.35,0a1.35,1.35 0 1,0 2.7,0a1.35,1.35 0 1,0 -2.7,0" />
        <!-- Camera body + lens ring, tilted -14° around the pivot -->
        <group
            android:name="camera"
            android:pivotX="10"
            android:pivotY="8"
            android:rotation="-14">
            <path
                android:fillColor="#FFFFFFFF"
                android:pathData="M7,8.8h8.4a1.4,1.4 0 0 1 1.4,1.4v1.6a1.4,1.4 0 0 1 -1.4,1.4H7a1.4,1.4 0 0 1 -1.4,-1.4v-1.6A1.4,1.4 0 0 1 7,8.8z" />
            <path
                android:fillColor="#FFFFFFFF"
                android:pathData="M19.9,11m-1.75,0a1.75,1.75 0 1,0 3.5,0a1.75,1.75 0 1,0 -3.5,0" />
        </group>
    </group>
</vector>
