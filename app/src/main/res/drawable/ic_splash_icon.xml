<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ splash icon: the brand-navy disc under the *actual* launcher foreground, so the
     splash can never drift from the launcher artwork. The halo behind it (windowSplashScreenBackground)
     flips bright (day) / navy (night) with the app's effective night mode. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/ic_launcher_background_color" />
        </shape>
    </item>
    <item
        android:bottom="9dp"
        android:drawable="@drawable/ic_launcher_foreground"
        android:left="9dp"
        android:right="9dp"
        android:top="9dp" />
</layer-list>
