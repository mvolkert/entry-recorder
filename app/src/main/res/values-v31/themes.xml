<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ system splash: overrides the automatic launcher-icon splash so the backdrop and
     CCTV mark follow the system day/night selection (see values-night/colors.xml). -->
<resources>
    <style name="Theme.EntryRecorder" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
    </style>
</resources>
