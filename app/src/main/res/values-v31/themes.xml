<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ system splash: the navy-disc splash icon is always readable, while the halo
     (windowSplashScreenBackground) flips bright (day) / navy (night) via values-night colors. -->
<resources>
    <style name="Theme.EntryRecorder" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
    </style>
</resources>
