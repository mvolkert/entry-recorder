<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ system splash: black backdrop with the CCTV mark,
     overriding the automatic launcher-icon splash on a dark theme. -->
<resources>
    <style name="Theme.EntryRecorder" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowSplashScreenBackground">@color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
    </style>
</resources>
