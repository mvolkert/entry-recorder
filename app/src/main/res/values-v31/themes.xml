<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ system splash: no windowSplashScreenAnimatedIcon override, so the system reuses the
     launcher mark and the splash can never drift from it. The backdrop is the brand navy, matching
     ic_launcher_background, so the mark sits on navy just like the launcher icon. -->
<resources>
    <style name="Theme.EntryRecorder" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
    </style>
</resources>
