<resources>
    <style name="Theme.EntryRecorder" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
    </style>

    <style name="Theme.EntryRecorder.LockScreen" parent="Theme.EntryRecorder">
        <item name="android:windowShowWhenLocked">true</item>
        <item name="android:windowTurnScreenOn">true</item>
        <item name="android:windowKeepScreenOn">true</item>
        <item name="android:showWhenLocked">true</item>
        <item name="android:turnScreenOn">true</item>
    </style>
</resources>
